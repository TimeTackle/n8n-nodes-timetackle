{
	"name": "@timetackle/n8n-nodes-timetackle",
	"version": "0.3.0",
	"description": "n8n community node for TimeTackle — workforce analytics and calendar management platform. Export calendar data, manage properties, sync CRM, and more.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"timetackle",
		"calendar",
		"analytics",
		"workforce",
		"crm",
		"time-tracking"
	],
	"license": "MIT",
	"homepage": "https://timetackle.com",
	"author": {
		"name": "TimeTackle",
		"email": "support@timetackle.com",
		"url": "https://timetackle.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/TimeTackle/n8n-nodes-timetackle.git"
	},
	"engines": {
		"node": ">=22.0"
	},
	"main": "dist/nodes/TimeTackle/TimeTackle.node.js",
	"scripts": {
		"dev": "n8n-node dev",
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"prepublishOnly": "npm run lint && npm test && npm run build",
		"release": "npm run lint && npm test && npm run build && changeset publish",
		"test": "jest"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/TimeTackleApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/TimeTackle/TimeTackle.node.js",
			"dist/nodes/TimeTackle/TimeTackleTrigger.node.js"
		],
		"strict": true
	},
	"devDependencies": {
		"@changesets/cli": "^2.27.0",
		"@n8n/node-cli": "^0.57.5",
		"@types/jest": "29.5.14",
		"@types/node": "^22.0.0",
		"eslint": "^9.39.4",
		"jest": "29.7.0",
		"n8n-workflow": "^1.0.0",
		"nock": "14.0.17",
		"prettier": "^3.8.3",
		"ts-jest": "29.4.15",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
